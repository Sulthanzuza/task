# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Set to serve GET /health from the worker, for container health checks.
WORKER_HEALTH_PORT=
LOG_LEVEL=debug

# ---- Database ----
DATABASE_URL=postgres://taskmanager:taskmanager@localhost:5433/taskmanager

# ---- Auth ----
# openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_change_me_0000000000000000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# How long a just-rotated refresh token still works, so two tabs refreshing
# together are not mistaken for a stolen cookie. Keep it short.
REFRESH_GRACE_SECONDS=30
PASSWORD_RESET_TTL_MINUTES=30

# ---- Web ----
# The Vite dev server port. strictPort is on, so a clash fails loudly
# instead of moving and breaking the cookie origin.
WEB_PORT=5174

# Where the Vite dev proxy forwards /api and /socket.io.
API_URL=http://localhost:4000

# The canonical address of the web app; used to build links in emails.
WEB_ORIGIN=http://localhost:5174

# ---- CORS ----
# Extra origins allowed to call the API with credentials, comma separated.
# WEB_ORIGIN is always allowed, so this stays empty for a normal setup.
# Never use "*": the browser rejects a wildcard on a credentialed request.
# Example: CORS_ORIGINS=http://localhost:5174,https://tasks.example.com
CORS_ORIGINS=

COOKIE_DOMAIN=

# ---- Rate limits (per minute) ----
# Raise AUTH if a whole office shares one outbound IP.
AUTH_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=300
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# ---- Email (mailpit locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Task Manager <no-reply@taskmanager.local>"

# ---- Files ----
# Development keeps attachments on disk, in apps/api/uploads/ (git-ignored).
# Production refuses this and uses an S3-compatible bucket: see
# .env.production.example and docs/deploy.md.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# ---- Seed ----
SEED_TIMEZONE=Asia/Kolkata
SEED_PASSWORD=Password123!
