# Copy to .env.production on the server and fill in. Never commit the real one.
#
# The API refuses to start in production if any of these is wrong, rather than
# running in a weakened state that looks healthy. See config/env.ts.

NODE_ENV=production
PORT=4000

# ---- Database ----
# Used by the API, the worker, the migrate step and the backup job.
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=
POSTGRES_DB=taskmanager
DATABASE_URL=postgres://taskmanager:CHANGE_ME@postgres:5432/taskmanager

# ---- Auth ----
# openssl rand -hex 32
# A development default here is refused at start-up.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_GRACE_SECONDS=30
PASSWORD_RESET_TTL_MINUTES=30

# ---- Origins ----
# Must be https in production, or start-up is refused: the session cookie is
# otherwise readable by anyone on the network.
# The public hostname. nginx uses it for server_name and for the certificate
# path, and certbot issues against it, so it must be the real DNS name.
SERVER_NAME=tasks.example.com

WEB_ORIGIN=https://tasks.example.com
CORS_ORIGINS=
# Set only if the API is on a different subdomain from the app.
COOKIE_DOMAIN=

# ---- Rate limits ----
# Raising the auth limit is refused in production.
AUTH_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=300
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# ---- Email: Brevo ----
# Brevo's free plan: 300 emails a day, plenty for a team this size. The sending
# domain must be authenticated in Brevo (SPF, DKIM) first, or the mail lands in
# spam or is rejected outright. See "Email: Brevo" in docs/deploy.md.
#
# Port 587 with STARTTLS: the connection starts plain and is upgraded, which
# is SMTP_SECURE=false. (true means TLS from the first byte, which is port 465.)
# Oracle blocks outbound port 25; 587 is open.
#
# SMTP_USER is the "Login" on Brevo's SMTP & API page (it looks like
# 1a2b3c001@smtp-brevo.com), not your Brevo account email. SMTP_PASS is an
# SMTP key generated on that page, not an API key.
MAIL_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# An address at the domain you authenticated in Brevo.
MAIL_FROM="Task Manager <no-reply@example.com>"

# ---- Background jobs ----
JOB_QUEUE_ENABLED=true
EMAIL_DEBOUNCE_SECONDS=300
WORKER_HEALTH_PORT=4001

# ---- Files: OCI Object Storage ----
# local keeps uploads on one container's disk, which is refused in production.
#
# Oracle's S3-compatible endpoint. 20 GB and 50,000 requests a month are in
# Always Free. <namespace> is on Tenancy details as "Object storage namespace";
# the region is ap-mumbai-1 or ap-hyderabad-1, whichever the VM is in.
# The keys are a Customer Secret Key for a user that can reach this bucket
# only. See "Attachments: OCI Object Storage" in docs/deploy.md.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com
S3_REGION=ap-mumbai-1
S3_BUCKET=task-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# OCI's compatibility API takes the bucket in the path, not the hostname.
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400

# The AWS SDK sends CRC checksums on every request by default. Not every
# S3-compatible store accepts them, so only send them where S3 requires one.
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# ---- Backups ----
BACKUP_INTERVAL_SECONDS=86400

# ---------------------------------------------------------------------------
# Off-site backups
#
# A separate provider, not this server and not the same account. A backup in
# the same place as the thing it protects survives a disk failure and nothing
# else: not a deleted account, not ransomware, not a provider outage.
#
# Backblaze B2 (10 GB free). The endpoint and region are on the bucket's page,
# as "Endpoint: s3.<region>.backblazeb2.com"; the region is the middle part.
# The key is an Application Key restricted to this one bucket: keyID is the
# access key, applicationKey the secret. It is shown once, when created.
# Set the bucket's lifecycle to "Keep only the last version of the file", or
# deleted dumps are only hidden and stay (and are billed) for ever.
# See "Backups: Backblaze B2" in docs/deploy.md.
# ---------------------------------------------------------------------------
BACKUP_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
BACKUP_S3_REGION=<region>
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Days to keep the off-site copies. The local ones are kept for three, since
# they are a convenience rather than the backup.
BACKUP_RETENTION_DAYS=14
BACKUP_LOCAL_RETENTION_DAYS=3

LOG_LEVEL=info
