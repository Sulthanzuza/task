# Copy to .env.production on the server and fill in. Never commit the real one.
#
# The API refuses to start in production if any of these is wrong, rather than
# running in a weakened state that looks healthy. See config/env.ts.

NODE_ENV=production
PORT=4000

# ---- Database ----
# Used by the API, the worker, the migrate step and the backup job.
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=
POSTGRES_DB=taskmanager
DATABASE_URL=postgres://taskmanager:CHANGE_ME@postgres:5432/taskmanager

# ---- Auth ----
# openssl rand -hex 32
# A development default here is refused at start-up.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_GRACE_SECONDS=30
PASSWORD_RESET_TTL_MINUTES=30

# ---- Origins ----
# Must be https in production, or start-up is refused: the session cookie is
# otherwise readable by anyone on the network.
# The public hostname. nginx uses it for server_name and for the certificate
# path, and certbot issues against it, so it must be the real DNS name.
SERVER_NAME=tasks.example.com

WEB_ORIGIN=https://tasks.example.com
CORS_ORIGINS=
# Set only if the API is on a different subdomain from the app.
COOKIE_DOMAIN=

# ---- Rate limits ----
# Raising the auth limit is refused in production.
AUTH_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=300
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# ---- Email ----
# A real provider, with SPF and DKIM set up for the sending domain. See
# docs/deploy.md; without them the mail lands in spam or is rejected outright.
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Task Manager <no-reply@tasks.example.com>"

# ---- Background jobs ----
JOB_QUEUE_ENABLED=true
EMAIL_DEBOUNCE_SECONDS=300
WORKER_HEALTH_PORT=4001

# ---- Files ----
# local keeps uploads on one container's disk, which is refused in production.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=task-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400

# ---- Backups ----
BACKUP_INTERVAL_SECONDS=86400

# ---------------------------------------------------------------------------
# Off-site backups
#
# A separate provider, not this server and not the same account. A backup in
# the same place as the thing it protects survives a disk failure and nothing
# else: not a deleted account, not ransomware, not a provider outage.
#
# Anything with an S3 endpoint works. Backblaze B2, Cloudflare R2 and Wasabi
# are all cheap enough that this costs pennies a month at this size.
#   B2:     https://s3.us-west-004.backblazeb2.com
#   R2:     https://<account-id>.r2.cloudflarestorage.com
#   Wasabi: https://s3.eu-central-1.wasabisys.com
# ---------------------------------------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=

# Days to keep the off-site copies. The local ones are kept for three, since
# they are a convenience rather than the backup.
BACKUP_RETENTION_DAYS=14
BACKUP_LOCAL_RETENTION_DAYS=3

LOG_LEVEL=info
