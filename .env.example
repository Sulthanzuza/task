# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Database ----
DATABASE_URL=postgres://taskmanager:taskmanager@localhost:5433/taskmanager

# ---- Auth ----
# openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_change_me_0000000000000000
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

# ---- Web / CORS ----
WEB_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=

# ---- Email (mailpit locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Task Manager <no-reply@taskmanager.local>"

# ---- Files ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=task-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400

# ---- Seed ----
SEED_TIMEZONE=Asia/Kolkata
SEED_PASSWORD=Password123!
